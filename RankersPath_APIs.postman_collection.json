          "name": "Admin / Staff Login (Auto-saves {{admin_token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('admin_token', jsonData.data.token);",
                  "    console.log('✅ Admin token saved automatically:', jsonData.data.token.slice(0, 15) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
