    {
      "name": "4. Cashfree Payment Gateway (PG v3)",
      "item": [
        {
          "name": "1. Create Cashfree Order (Auto-saves {{order_id}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    if (jsonData.data.order_id) {",
                  "        pm.environment.set('order_id', jsonData.data.order_id);",
                  "        console.log('✅ order_id saved:', jsonData.data.order_id);",
                  "    }",
                  "    if (jsonData.data.payment_session_id) {",
                  "        pm.environment.set('payment_session_id', jsonData.data.payment_session_id);",
                  "        console.log('✅ payment_session_id saved:', jsonData.data.payment_session_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1,\n  \"currency\": \"INR\",\n  \"purpose\": \"REAL_GATEWAY_TEST\",\n  \"orderNote\": \"Postman Live Test\",\n  \"customerDetails\": {\n    \"name\": \"Aman Sharma\",\n    \"phone\": \"9876543210\",\n    \"email\": \"student@rankerspath.in\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/cashfree/create-order",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments",
                "cashfree",
                "create-order"
              ]
            },
            "description": "Creates Cashfree order on Sandbox/Production and returns payment_session_id"
          }
        },
