# ===================================================
# RANKERS PATH MAIN WEBSITE ENVIRONMENT VARIABLES
# ===================================================

# Backend API Base URL
# In Local Development: http://localhost:5002/api
# In Production: https://api.rankerspath.in/api (or your backend domain)
VITE_API_BASE_URL=http://localhost:5002/api

# Admin Portal URL (for staff / admin navigation)
# In Local Development: http://localhost:5174
# In Production: https://admin.rankerspath.in
VITE_ADMIN_PORTAL_URL=http://localhost:5174

# Cashfree PG v3 Environment (TEST | PROD)
VITE_CASHFREE_ENV=TEST
VITE_CASHFREE_APP_ID=your_cashfree_app_id_here

