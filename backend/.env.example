# ===================================================
# RANKERS PATH BACKEND SERVER ENVIRONMENT VARIABLES
# ===================================================

# Server Port
PORT=5002

# Environment Mode (development | production)
NODE_ENV=production

# JWT Authentication Secret (Use a strong 64-char random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Cashfree Payments (PG v3 API) Credentials
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# CORS Allowed Origins (Comma separated URLs)
ALLOWED_ORIGINS=https://rankerspath.in,https://admin.rankerspath.in,http://localhost:5174,http://localhost:5175

